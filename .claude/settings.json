{
  "autoMode": {
    "allow": [
      "$defaults",
      "Deleting entries inside /home/xaviuzz/sandbox/PrometeuZZ/Sandbox and /home/xaviuzz/sandbox/PrometeuZZ/Sandbox/TMP with find -mindepth 1 -maxdepth 1 -exec rm -rf, as the /clean skill does. Sandbox is git-ignored and disposable. Nothing outside Sandbox is covered."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-read-only.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent-docs-need-skill.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/context-warning.sh"
          }
        ]
      }
    ]
  }
}
